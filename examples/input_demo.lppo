// Demonstrates complex input capabilities in LPPO

pub proc main() -> Void {
    // Simple string input with prompt
    input name: Str with "Enter your name:";
    let own greeting: Str = "Hello,";
    out greeting, name;
    
    // Integer input with prompt
    input age: Int64 with "Enter your age:";
    let own age_label: Str = "You are";
    let own years_label: Str = "years old";
    out age_label, age, years_label;
    
    // Boolean input
    input is_student: Bool with "Are you a student? (true/false):";
    let own student_msg: Str = "Student status:";
    out student_msg, is_student;
    
    // Array input demo
    let own array_prompt: Str = "Enter favorite numbers (comma-separated):";
    out array_prompt;
    input numbers: Arr<Int64>;
    let own numbers_label: Str = "Your numbers:";
    out numbers_label, numbers;
    
    // Calculate sum of input numbers
    let mut own total: Int64 = 0;
    let own zero: Int64 = 0;
    
    for num: Int64 in numbers {
        let own new_total: Int64 = total + num;
        move new_total -> total;
    }
    
    let own sum_label: Str = "Sum of your numbers:";
    out sum_label, total;
}
