// ============================================================================
// CATEGORY 8: Numeric Operations
// ============================================================================

pub proc demo_numeric_operations() -> Void {
    out "=== Numeric Operations Demo ===";
    
    let own a: Int64 = 10;
    let own b: Int64 = 3;
    
    // Basic arithmetic
    let own sum: Int64 = a + b;
    let own diff: Int64 = a - b;
    let own prod: Int64 = a * b;
    let own quot: Int64 = a / b;
    let own rem: Int64 = a % b;
    
    out "a =", a, ", b =", b;
    out "Addition:", a, "+", b, "=", sum;
    out "Subtraction:", a, "-", b, "=", diff;
    out "Multiplication:", a, "*", b, "=", prod;
    out "Division:", a, "/", b, "=", quot;
    out "Modulo:", a, "%", b, "=", rem;
    
    // Power (simulated)
    let own power: Int64 = power_of(2, 10);
    out "2^10 =", power;
    
    // Factorial
    let own fact: Int64 = factorial(6);
    out "6! =", fact;
    
    // Fibonacci
    let own fib: Int64 = fibonacci(10);
    out "fibonacci(10) =", fib;
}

pub proc power_of(base: Int64, exp: Int64) -> Int64 {
    let mut own result: Int64 = 1;
    let mut own i: Int64 = 0;
    while i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

pub proc factorial(n: Int64) -> Int64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

pub proc fibonacci(n: Int64) -> Int64 {
    if n <= 1 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

