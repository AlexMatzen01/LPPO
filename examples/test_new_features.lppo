// Test file for newly implemented features
// Tests: function calls and pattern matching improvements

pub proc main() -> Void {
    out "=== Testing Function Calls as Statements ===";
    
    // Call helper functions
    call add(10, 20);
    call multiply(5, 6);
    
    out "";
    out "=== Testing Pattern Matching ===";
    
    // Test simple literal patterns
    let own num: Int64 = 5;
    match num {
        1 => out "One",
        2 => out "Two",
        5 => out "Five - Match found!",
        _ => out "Other number",
    };
    
    // Test simple value matching
    let own maybe: Int64 = 42;
    match maybe {
        42 => out "Found the answer!",
        _ => out "Not the answer",
    };
    
    out "";
    out "All tests completed!";
}

pub proc add(a: Int64, b: Int64) -> Void {
    let own result: Int64 = a + b;
    out "add:", a, "+", b, "=", result;
}

pub proc multiply(a: Int64, b: Int64) -> Void {
    let own result: Int64 = a * b;
    out "multiply:", a, "*", b, "=", result;
}
