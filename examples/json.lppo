pub proc main() -> Void {
    out "=== JSON Support ===";

    let own person: Str = "{\"name\": \"Alice\", \"age\": 30, \"active\": true, \"tags\": [\"a\", \"b\"]}";
    out "JSON input:", person;

    let own parsed: Str = json_parse(person);
    out "Parsed:", parsed;

    let own back: Str = json_stringify(parsed);
    out "Stringified:", back;

    out "Array roundtrip:", json_stringify(json_parse("[1, 2, 3]"));
    out "Object roundtrip:", json_stringify(json_parse("{\"x\": 10, \"y\": 20}"));
}
