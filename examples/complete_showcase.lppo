// LPPO v2.0 - Complete Complexity Showcase
// This file demonstrates ALL advanced features requiring maximum verbosity

// Helper procedure with array parameter
pub proc sum_array(arr: Arr<Int64>) -> Void {
    let mut own total: Int64 = 0;
    let own zero: Int64 = 0;
    
    for element: Int64 in arr {
        let own new_total: Int64 = total + element;
        move new_total -> total;
    }
    
    let own sum_label: Str = "Array sum:";
    out sum_label, total;
}

// Main entry point with explicit signature
pub proc main() -> Void {
    // Section 1: Type System Demonstration
    scope type_system_demo {
        let own header: Str = "=== Type System Demo ===";
        out header;
        
        // ALL variables require explicit type annotations
        let own integer: Int64 = 42;
        let own boolean: Bool = true;
        let own text: Str = "LPPO v2.0";
        let own numbers: Arr<Int64> = [1, 2, 3, 4, 5];
        
        // Type introspection operations
        let own int_size: Int64 = sizeof<Int64>;
        let own bool_size: Int64 = sizeof<Bool>;
        let own str_size: Int64 = sizeof<Str>;
        
        let own size_label: Str = "Type sizes:";
        out size_label, int_size, bool_size, str_size;
        
        // Explicit type casting
        let own as_bool: Bool = cast<Bool>(integer);
        let own cast_label: Str = "Cast 42 to Bool:";
        out cast_label, as_bool;
    }
    
    // Section 2: Memory Management Demonstration
    scope memory_management_demo {
        let own empty: Str = "";
        out empty;
        
        let own header2: Str = "=== Memory Management Demo ===";
        out header2;
        
        // Ownership semantics
        let own original: Int64 = 100;
        let own copy_target: Int64 = 0;
        
        // Explicit copy operation
        copy original -> copy_target;
        let own copy_label: Str = "Copied value:";
        out copy_label, copy_target;
        
        // Move semantics
        let own source: Int64 = 200;
        let mut own destination: Int64 = 0;
        move source -> destination;
        let own move_label: Str = "Moved value:";
        out move_label, destination;
        
        // Reference operations
        let own value: Int64 = 300;
        let ref reference: Ref<Int64> = ref value;
        let own deref_result: Int64 = deref reference;
        let own ref_label: Str = "Dereferenced:";
        out ref_label, deref_result;
    }
    
    // Section 3: Explicit Loop Constructs
    scope loop_constructs_demo {
        let own empty2: Str = "";
        out empty2;
        
        let own header3: Str = "=== Loop Constructs Demo ===";
        out header3;
        
        // While loop with explicit mutable counter
        let mut own counter: Int64 = 0;
        let own limit: Int64 = 5;
        
        while counter < limit {
            let own while_label: Str = "While iteration:";
            out while_label, counter;
            
            let own counter_next: Int64 = counter + 1;
            move counter_next -> counter;
        }
        
        // For loop with explicit type annotation
        let own for_data: Arr<Int64> = [10, 20, 30];
        for item: Int64 in for_data {
            let own for_label: Str = "For item:";
            out for_label, item;
        }
        
        // Infinite loop with explicit break condition
        let mut own loop_count: Int64 = 0;
        let own max_count: Int64 = 3;
        
        loop {
            let own loop_label: Str = "Loop count:";
            out loop_label, loop_count;
            
            let own loop_count_next: Int64 = loop_count + 1;
            move loop_count_next -> loop_count;
            
            let own should_exit: Bool = loop_count >= max_count;
            if should_exit {
                break;
            }
        }
    }
    
    // Section 4: Conditional Logic with Explicit Types
    scope conditional_logic_demo {
        let own empty3: Str = "";
        out empty3;
        
        let own header4: Str = "=== Conditional Logic Demo ===";
        out header4;
        
        let own x: Int64 = 15;
        let own y: Int64 = 10;
        let own z: Int64 = 15;
        
        // All conditions must be explicitly typed Bool variables
        let own is_greater: Bool = x > y;
        
        if is_greater {
            let own msg1: Str = "x is greater than y";
            out msg1;
        } else {
            let own msg2: Str = "x is not greater";
            out msg2;
        }
        
        // Complex condition with explicit boolean operations
        let own is_equal: Bool = x == z;
        let own is_positive: Bool = x > 0;
        let own combined: Bool = is_equal and is_positive;
        
        if combined {
            let own msg3: Str = "x equals z and both are positive";
            out msg3;
        }
    }
    
    // Section 5: Array Operations with Explicit Types
    scope array_operations_demo {
        let own empty4: Str = "";
        out empty4;
        
        let own header5: Str = "=== Array Operations Demo ===";
        out header5;
        
        let own array: Arr<Int64> = [5, 10, 15, 20, 25];
        let own arr_len: Int64 = array.len();
        let own len_label: Str = "Array length:";
        out len_label, arr_len;
        
        // Explicit indexing with typed indices
        let own idx_zero: Int64 = 0;
        let own idx_two: Int64 = 2;
        let own idx_last: Int64 = -1;
        
        let own first: Int64 = array[idx_zero];
        let own third: Int64 = array[idx_two];
        let own last: Int64 = array[idx_last];
        
        let own index_label: Str = "Elements:";
        out index_label, first, third, last;
        
        // Array concatenation with explicit types
        let own arr1: Arr<Int64> = [1, 2, 3];
        let own arr2: Arr<Int64> = [4, 5, 6];
        let own concatenated: Arr<Int64> = arr1 + arr2;
        let own concat_label: Str = "Concatenated:";
        out concat_label, concatenated;
    }
    
    // Section 6: String Operations with Explicit Types
    scope string_operations_demo {
        let own empty5: Str = "";
        out empty5;
        
        let own header6: Str = "=== String Operations Demo ===";
        out header6;
        
        let own text: Str = "LPPO v2.0";
        let own text_len: Int64 = text.len();
        let own upper_text: Str = text.upper();
        let own lower_text: Str = text.lower();
        
        let own str_label: Str = "String ops:";
        out str_label, text_len, upper_text, lower_text;
        
        // String splitting with explicit types
        let own csv: Str = "alpha,beta,gamma";
        let own separator: Str = ",";
        let own parts: Arr<Str> = csv.split(separator);
        let own split_label: Str = "Split result:";
        out split_label, parts;
        
        // String concatenation with multiple steps
        let own word1: Str = "Complex";
        let own space: Str = " ";
        let own word2: Str = "Language";
        let own temp: Str = word1 + space;
        let own final: Str = temp + word2;
        let own concat_str_label: Str = "Concatenated string:";
        out concat_str_label, final;
    }
    
    // Section 7: Operator Showcase with Explicit Types
    scope operator_showcase {
        let own empty6: Str = "";
        out empty6;
        
        let own header7: Str = "=== Operator Showcase ===";
        out header7;
        
        // Arithmetic operators - all require explicit typing
        let own a: Int64 = 20;
        let own b: Int64 = 7;
        
        let own add_res: Int64 = a + b;
        let own sub_res: Int64 = a - b;
        let own mul_res: Int64 = a * b;
        let own div_res: Int64 = a / b;
        let own mod_res: Int64 = a % b;
        let own pow_base: Int64 = 2;
        let own pow_exp: Int64 = 5;
        let own pow_res: Int64 = pow_base ** pow_exp;
        
        let own arith_label: Str = "Arithmetic:";
        out arith_label, add_res, sub_res, mul_res, div_res, mod_res, pow_res;
        
        // Bitwise operators on explicit Int64
        let own bit_a: Int64 = 12;
        let own bit_b: Int64 = 10;
        let own and_res: Int64 = bit_a & bit_b;
        let own or_res: Int64 = bit_a | bit_b;
        let own xor_res: Int64 = bit_a ^ bit_b;
        let own not_res: Int64 = ~bit_a;
        
        let own bitwise_label: Str = "Bitwise:";
        out bitwise_label, and_res, or_res, xor_res, not_res;
        
        // Comparison operators - return explicit Bool
        let own gt_res: Bool = a > b;
        let own lt_res: Bool = a < b;
        let own eq_res: Bool = a == b;
        let own ne_res: Bool = a != b;
        
        let own comp_label: Str = "Comparisons:";
        out comp_label, gt_res, lt_res, eq_res, ne_res;
        
        // Logical operators on explicit Bool
        let own flag1: Bool = true;
        let own flag2: Bool = false;
        let own and_logic: Bool = flag1 and flag2;
        let own or_logic: Bool = flag1 or flag2;
        let own not_logic: Bool = not flag1;
        
        let own logic_label: Str = "Logical:";
        out logic_label, and_logic, or_logic, not_logic;
    }
    
    // Section 8: Parallel Execution with Explicit Scope
    scope parallel_execution_demo {
        let own empty7: Str = "";
        out empty7;
        
        let own header8: Str = "=== Parallel Execution Demo ===";
        out header8;
        
        scope parallel_block {
            parallel {
                let own task1: Str = "Parallel Task 1";
                out task1;
                
                let own task2: Str = "Parallel Task 2";
                out task2;
                
                let own task3: Str = "Parallel Task 3";
                out task3;
            }
        }
        
        let own resume: Str = "Resumed after parallel execution";
        out resume;
    }
    
    // Section 9: Procedure Call Demo
    scope procedure_call_demo {
        let own empty8: Str = "";
        out empty8;
        
        let own header9: Str = "=== Procedure Call Demo ===";
        out header9;
        
        let own arr_to_sum: Arr<Int64> = [10, 20, 30, 40, 50];
        
        // Call helper procedure with explicit argument list
        call sum_array(arr_to_sum);
    }
    
    // Section 10: Unsafe Operations Block
    unsafe {
        let own empty9: Str = "";
        out empty9;
        
        let own header10: Str = "=== Unsafe Operations Demo ===";
        out header10;
        
        // Unsafe blocks allow potentially dangerous operations
        let own raw_value: Int64 = 0x42;
        let own unsafe_label: Str = "Raw value:";
        out unsafe_label, raw_value;
    }
    
    // Final summary
    // Final summary
    let own empty10: Str = "";
    out empty10;
    
    let own final_header: Str = "=== Complexity Showcase Complete ===";
    out final_header;
    
    let own summary_msg: Str = "All advanced features demonstrated with maximum verbosity!";
    out summary_msg;
}
