// LPPX3D example: 3D graphics using Vulkan via LPPO FFI
//
// Build: lppo project build --entry examples/shader3d.lppo --output target/shader3d
// Run:   ./target/shader3d   (opens a Vulkan window)
//
// Requires: LPPX3D package installed (~/.LPPO/packages/liblppo_x3d.so)

use LPPX3D;

pub proc main() -> Void {
    out "=== LPPX3D Shader Example ===";
    out "Opening 1024x768 Vulkan window...";

    let win: Int64 = x3d_window_create("LPPX3D Demo", 1024, 768);
    out "Window created, id:", win;

    let cam: Int64 = x3d_camera_create();
    out "Camera created, id:", cam;

    let cube: Int64 = x3d_mesh_cube();
    out "Cube mesh created, id:", cube;

    let mat: Int64 = x3d_material_create("red_material");
    out "Material created, id:", mat;

    x3d_begin_frame(win);
    x3d_end_frame(win);

    out "3D shader example complete.";
}
