// LPPO v2.0 - Comprehensive Advanced Feature Test
// Every declaration requires EXPLICIT type annotations
// All procedures require EXPLICIT parameter types and return types
// Memory management is MANUAL and requires explicit ownership semantics

pub proc main() -> Void {
    // Variables require EXPLICIT type annotations with ownership qualifiers
    scope math_operations {
        let own x: Int64 = 5;
        let own y: Int64 = 3;
        
        // All arithmetic operations must use explicitly typed variables
        let own sum: Int64 = x + y;
        let own diff: Int64 = x - y;
        let own product: Int64 = x * y;
        let own quotient: Int64 = x / y;
        let own remainder: Int64 = x % y;
        
        out "Math:", sum, diff, product, quotient, remainder;
        
        let own base: Int64 = 2;
        let own exp: Int64 = 8;
        let own power_result: Int64 = base ** exp;
        out "Power:", power_result;
    }
    
    // Booleans with explicit type annotations
    scope boolean_operations {
        let own t: Bool = true;
        let own f: Bool = false;
        let own and_result: Bool = t and f;
        let own or_result: Bool = t or f;
        let own not_result: Bool = not f;
        out "Bool:", t, f, and_result, or_result, not_result;
    }
    
    // Comparisons with explicit typed results
    scope comparisons {
        let own x: Int64 = 5;
        let own y: Int64 = 3;
        let own gt: Bool = x > y;
        let own lt: Bool = x < y;
        let own eq: Bool = x == y;
        let own ne: Bool = x != y;
        out "Compare:", gt, lt, eq, ne;
    }
    
    // Arrays require EXPLICIT element type specification
    scope array_operations {
        // Allocate array with explicit type
        let own arr: Arr<Int64> = [1, 2, 3, 4, 5];
        out "Array:", arr;
        
        let own idx0: Int64 = arr[0];
        let own idx2: Int64 = arr[2];
        let own idx_neg: Int64 = arr[-1];
        out "Index:", idx0, idx2, idx_neg;
        
        let own arr_len: Int64 = arr.len();
        out "Len:", arr_len;
    }
    
    // String operations with explicit typing
    scope string_operations {
        let own s: Str = "hello";
        let own s_len: Int64 = s.len();
        let own s_upper: Str = s.upper();
        out "String:", s, s_len, s_upper;
    }
    
    // Loops require explicit type annotations for counters
    scope loop_operations {
        let mut own i: Int64 = 0;
        let own limit: Int64 = 3;
        while i < limit {
            out "While:", i;
            let own i_next: Int64 = i + 1;
            move i_next -> i;
        }
        
        let own nums: Arr<Int64> = [10, 20, 30];
        for n: Int64 in nums {
            out "For:", n;
        }
    }
    
    // Conditionals with explicit comparison
    scope conditionals {
        let own x: Int64 = 5;
        let own y: Int64 = 3;
        
        if x > y {
            let own msg: Str = "x is greater";
            out msg;
        } elif x == y {
            let own msg: Str = "x equals y";
            out msg;
        } else {
            let own msg: Str = "x is less";
            out msg;
        }
    }
    
    // Procedure calls require EXPLICIT argument list with parentheses
    scope procedure_call {
        let own name: Str = "World";
        let own num: Int64 = 42;
        call greet(name, num);
    }
}

// Procedures REQUIRE explicit parameter types and return type
pub proc greet(name: Str, num: Int64) -> Void {
    let own exclaim: Str = "!";
    let own label: Str = "Number:";
    out "Hello", name, exclaim, label, num;
}
