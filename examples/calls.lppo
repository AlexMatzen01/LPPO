// LPPO v2.0 - Procedure Calls with Explicit Signatures
// ALL procedures REQUIRE explicit parameter list (even if empty) and return type
// ALL procedure calls REQUIRE explicit argument list with parentheses

pub proc greet() -> Void {
    let own msg: Str = "greet: Hello from called proc";
    out msg;
}

pub proc main() -> Void {
    let own before_msg: Str = "Before call";
    out before_msg;
    
    // Procedure calls MUST include explicit parentheses even with no arguments
    call greet();
    
    let own after_msg: Str = "After call";
    out after_msg;
}
