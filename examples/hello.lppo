// LPPO v2.0 - Advanced Syntax with Explicit Type Annotations and Memory Management
// All procedures REQUIRE explicit parameter types and return types
// All variables REQUIRE explicit type annotations
// Memory management is MANUAL and EXPLICIT

pub proc main() -> Void {
    // Every variable declaration requires EXPLICIT type annotation
    let own msg1: Str = "Hello from LPPO v2.0!";
    out msg1;
    
    let own msg2: Str = "Outputs stream sequential statements.";
    out msg2;
    
    // Parallel blocks require explicit scope management
    scope parallel_section {
        parallel {
            out "Parallel branch one.";
            out "Parallel branch two.";
            out "Parallel branch three.";
        }
    }
    
    let own resume_msg: Str = "Main procedure resumed after parallel block.";
    out resume_msg;
}
