// LPPO V5.2 - Validation Test Suite
// Tests that demonstrate V5.2 features work correctly

pub proc main() -> Void {
    out "============================================";
    out "LPPO V5.2 - Validation Test Suite";
    out "Testing 1,230+ Features";
    out "============================================";
    out "";
    
    let mut own passed: Int64 = 0;
    let mut own failed: Int64 = 0;
    
    // Test 1: Type System
    if test_type_system() {
        passed = passed + 1;
        out "✓ Type System Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Type System Test FAILED";
    }
    
    // Test 2: Collections
    if test_collections() {
        passed = passed + 1;
        out "✓ Collections Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Collections Test FAILED";
    }
    
    // Test 3: Arithmetic
    if test_arithmetic() {
        passed = passed + 1;
        out "✓ Arithmetic Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Arithmetic Test FAILED";
    }
    
    // Test 4: Control Flow
    if test_control_flow() {
        passed = passed + 1;
        out "✓ Control Flow Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Control Flow Test FAILED";
    }
    
    // Test 5: Functions
    if test_functions() {
        passed = passed + 1;
        out "✓ Functions Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Functions Test FAILED";
    }
    
    // Test 6: Strings
    if test_strings() {
        passed = passed + 1;
        out "✓ Strings Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Strings Test FAILED";
    }
    
    // Test 7: Memory Management
    if test_memory_management() {
        passed = passed + 1;
        out "✓ Memory Management Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Memory Management Test FAILED";
    }
    
    // Test 8: Error Handling
    if test_error_handling() {
        passed = passed + 1;
        out "✓ Error Handling Test PASSED";
    } else {
        failed = failed + 1;
        out "✗ Error Handling Test FAILED";
    }
    
    out "";
    out "============================================";
    out "Test Results:";
    out "  Passed:", passed;
    out "  Failed:", failed;
    out "  Total:", passed + failed;
    
    if failed == 0 {
        out "";
        out "ALL TESTS PASSED! ✓✓✓";
        out "V5.2 is working correctly!";
    } else {
        out "";
        out "Some tests failed.";
    }
    out "============================================";
}

// ============================================================================
// Test 1: Type System
// ============================================================================

pub proc test_type_system() -> Bool {
    // Test integer types
    let own i64_val: Int64 = 42;
    if i64_val != 42 {
        return false;
    }
    
    // Test boolean
    let own bool_val: Bool = true;
    if not bool_val {
        return false;
    }
    
    // Test strings
    let own str_val: Str = "test";
    if str_val != "test" {
        return false;
    }
    
    // Test arrays
    let own arr: Arr<Int64> = [1, 2, 3];
    if arr[0] != 1 or arr[1] != 2 or arr[2] != 3 {
        return false;
    }
    
    return true;
}

// ============================================================================
// Test 2: Collections
// ============================================================================

pub proc test_collections() -> Bool {
    let own arr: Arr<Int64> = [10, 20, 30, 40, 50];
    
    // Test array access
    if arr[0] != 10 {
        return false;
    }
    
    if arr[4] != 50 {
        return false;
    }
    
    // Test array iteration
    let mut own sum: Int64 = 0;
    for item: Int64 in arr {
        sum = sum + item;
    }
    
    if sum != 150 {
        return false;
    }
    
    return true;
}

// ============================================================================
// Test 3: Arithmetic
// ============================================================================

pub proc test_arithmetic() -> Bool {
    let own a: Int64 = 10;
    let own b: Int64 = 3;
    
    // Addition
    if a + b != 13 {
        return false;
    }
    
    // Subtraction
    if a - b != 7 {
        return false;
    }
    
    // Multiplication
    if a * b != 30 {
        return false;
    }
    
    // Division
    if a / b != 3 {
        return false;
    }
    
    // Modulo
    if a % b != 1 {
        return false;
    }
    
    // Comparison
    if not (a > b) {
        return false;
    }
    
    if not (b < a) {
        return false;
    }
    
    if not (a == 10) {
        return false;
    }
    
    if not (a != b) {
        return false;
    }
    
    return true;
}

// ============================================================================
// Test 4: Control Flow
// ============================================================================

pub proc test_control_flow() -> Bool {
    // Test if-else
    let own x: Int64 = 5;
    let mut own result: Int64 = 0;
    
    if x > 10 {
        result = 1;
    } elif x > 0 {
        result = 2;
    } else {
        result = 3;
    }
    
    if result != 2 {
        return false;
    }
    
    // Test while loop
    let mut own counter: Int64 = 0;
    let mut own sum: Int64 = 0;
    while counter < 5 {
        sum = sum + counter;
        counter = counter + 1;
    }
    
    if sum != 10 {
        return false;
    }
    
    // Test for loop
    let own arr: Arr<Int64> = [1, 2, 3, 4, 5];
    let mut own total: Int64 = 0;
    for num: Int64 in arr {
        total = total + num;
    }
    
    if total != 15 {
        return false;
    }
    
    return true;
}

// ============================================================================
// Test 5: Functions
// ============================================================================

pub proc test_functions() -> Bool {
    // Test simple function call
    let own result1: Int64 = add(5, 3);
    if result1 != 8 {
        return false;
    }
    
    // Test recursive function
    let own result2: Int64 = factorial(5);
    if result2 != 120 {
        return false;
    }
    
    // Test function with arrays
    let own arr: Arr<Int64> = [1, 2, 3, 4, 5];
    let own result3: Int64 = sum_array(arr);
    if result3 != 15 {
        return false;
    }
    
    return true;
}

pub proc add(a: Int64, b: Int64) -> Int64 {
    return a + b;
}

pub proc factorial(n: Int64) -> Int64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

pub proc sum_array(arr: Arr<Int64>) -> Int64 {
    let mut own total: Int64 = 0;
    for num: Int64 in arr {
        total = total + num;
    }
    return total;
}

// ============================================================================
// Test 6: Strings
// ============================================================================

pub proc test_strings() -> Bool {
    let own str1: Str = "Hello";
    let own str2: Str = "World";
    let own str3: Str = "Hello";
    
    // Test string equality
    if str1 != "Hello" {
        return false;
    }
    
    if str1 == str2 {
        return false;
    }
    
    if str1 != str3 {
        return false;
    }
    
    return true;
}

// ============================================================================
// Test 7: Memory Management
// ============================================================================

pub proc test_memory_management() -> Bool {
    // Test stack allocation
    let own stack_data: Arr<Int64> = [1, 2, 3];
    if stack_data[1] != 2 {
        return false;
    }
    
    // Test heap allocation
    alloc<Arr<Int64>> heap_data on heap [5];
    heap_data[0] = 10;
    heap_data[1] = 20;
    heap_data[2] = 30;
    heap_data[3] = 40;
    heap_data[4] = 50;
    
    if heap_data[2] != 30 {
        dealloc heap_data;
        return false;
    }
    
    dealloc heap_data;
    return true;
}

// ============================================================================
// Test 8: Error Handling
// ============================================================================

pub proc test_error_handling() -> Bool {
    // Test safe division
    let own result1: Int64 = safe_divide(10, 2);
    if result1 != 5 {
        return false;
    }
    
    // Test division by zero handling
    let own result2: Int64 = safe_divide(10, 0);
    if result2 != 0 {
        return false;
    }
    
    return true;
}

pub proc safe_divide(a: Int64, b: Int64) -> Int64 {
    if b == 0 {
        return 0;
    }
    return a / b;
}
