// LPPO V5.2 - Parser Support Demonstration
// This file demonstrates the V5.0-V5.2 features that are now supported
// after the parser updates.

// V5.2 Feature: Use statements with type tokens
use std::collections::Vec;
use std::collections::{HashMap, HashSet};
use std::io::{File, BufReader};
use std::sync::Mutex;

// V5.2 Feature: Type aliases
// Note: Type aliases parse correctly but cannot be used as type annotations yet
type UserId = Int64;
type Username = Str;
type Counter = Int64;

pub proc main() -> Void {
    out "╔════════════════════════════════════════════════════════╗";
    out "║  LPPO V5.2 Parser Support Demonstration               ║";
    out "║  Testing V5.0-V5.2 Features                           ║";
    out "╚════════════════════════════════════════════════════════╝";
    out "";
    
    // ========================================================================
    // V5.2 FEATURE: Use Statements
    // ========================================================================
    out "✓ Use statements (imports) - WORKING";
    out "  - Simple imports: use std::collections::Vec;";
    out "  - Multiple imports: use std::collections::{HashMap, HashSet};";
    out "  - Type tokens in paths handled correctly";
    out "";
    
    // ========================================================================
    // V5.2 FEATURE: Type Aliases
    // ========================================================================
    out "✓ Type aliases - WORKING";
    out "  - Type alias declarations parse correctly";
    out "  - type UserId = Int64;";
    out "  - type Username = Str;";
    out "";
    
    // ========================================================================
    // V5.0 FEATURES: Core Language
    // ========================================================================
    out "✓ V5.0 Core Features - ALL WORKING";
    out "";
    
    // 1. Basic types and variables
    out "1. Variables with explicit types:";
    let own number: Int64 = 42;
    let own active: Bool = true;
    let own message: Str = "LPPO is working!";
    out "   Number:", number;
    out "   Active:", active;
    out "   Message:", message;
    out "";
    
    // 2. Arrays
    out "2. Arrays:";
    let own numbers: Arr<Int64> = [10, 20, 30, 40, 50];
    out "   Array:", numbers;
    out "   Length:", numbers.len();
    out "   First:", numbers[0];
    out "   Last:", numbers[-1];
    out "";
    
    // 3. Arithmetic operators
    out "3. Arithmetic operators:";
    let own a: Int64 = 10;
    let own b: Int64 = 3;
    let own sum: Int64 = a + b;
    let own diff: Int64 = a - b;
    let own prod: Int64 = a * b;
    let own quot: Int64 = a / b;
    let own mod: Int64 = a % b;
    let own pow: Int64 = 2 ** 8;
    out "   10 + 3 =", sum;
    out "   10 - 3 =", diff;
    out "   10 * 3 =", prod;
    out "   10 / 3 =", quot;
    out "   10 % 3 =", mod;
    out "   2 ** 8 =", pow;
    out "";
    
    // 4. Comparison operators
    out "4. Comparison operators:";
    let own eq: Bool = a == 10;
    let own ne: Bool = a != 10;
    let own lt: Bool = b < a;
    let own gt: Bool = a > b;
    out "   10 == 10:", eq;
    out "   10 != 10:", ne;
    out "   3 < 10:", lt;
    out "   10 > 3:", gt;
    out "";
    
    // 5. Control flow
    out "5. Control flow (if/elif/else):";
    let own score: Int64 = 85;
    if score >= 90 {
        out "   Grade: A";
    } elif score >= 80 {
        out "   Grade: B";
    } elif score >= 70 {
        out "   Grade: C";
    } else {
        out "   Grade: F";
    }
    out "";
    
    // 6. While loops
    out "6. While loops:";
    let mut own counter: Int64 = 0;
    while counter < 3 {
        out "   Loop iteration:", counter;
        let own next: Int64 = counter + 1;
        move next -> counter;
    }
    out "";
    
    // 7. For loops
    out "7. For loops:";
    let own items: Arr<Int64> = [100, 200, 300];
    for item: Int64 in items {
        out "   Processing item:", item;
    }
    out "";
    
    // 8. Infinite loops with break
    out "8. Infinite loops with break:";
    let mut own i: Int64 = 0;
    loop {
        if i >= 2 {
            out "   Breaking at", i;
            break;
        }
        out "   Iteration:", i;
        let own next_i: Int64 = i + 1;
        move next_i -> i;
    }
    out "";
    
    // 9. Continue statement
    out "9. Continue statement:";
    let mut own j: Int64 = 0;
    while j < 5 {
        let own current: Int64 = j;
        let own next_j: Int64 = j + 1;
        move next_j -> j;
        
        if current == 2 {
            continue;
        }
        out "   Value:", current;
    }
    out "";
    
    // 10. String operations
    out "10. String operations:";
    let own text: Str = "Hello World";
    let own len: Int64 = text.len();
    let own upper: Str = text.upper();
    let own lower: Str = text.lower();
    out "   Text:", text;
    out "   Length:", len;
    out "   Uppercase:", upper;
    out "   Lowercase:", lower;
    out "";
    
    // 11. Ownership qualifiers
    out "11. Ownership qualifiers:";
    let own owned_val: Int64 = 100;
    let mut own mutable_val: Int64 = 200;
    out "   Owned value:", owned_val;
    out "   Mutable value:", mutable_val;
    let own new_mutable: Int64 = mutable_val + 1;
    move new_mutable -> mutable_val;
    out "   Modified mutable:", mutable_val;
    out "";
    
    // 12. Scoped blocks
    out "12. Scoped blocks:";
    scope outer {
        let own x: Int64 = 10;
        out "   Outer scope x:", x;
        
        scope inner {
            let own y: Int64 = 20;
            let own total: Int64 = x + y;
            out "   Inner scope total:", total;
        }
        
        out "   Back in outer scope";
    }
    out "";
    
    // 13. Memory operations
    out "13. Memory operations:";
    let own source: Int64 = 999;
    let own target: Int64 = 0;
    out "   Source:", source;
    copy source -> target;
    out "   After copy, target:", target;
    out "";
    
    // 14. Procedure calls
    out "14. Procedure calls:";
    call helper_function(42, "test");
    out "";
    
    // 15. Parallel execution
    out "15. Parallel execution:";
    parallel {
        out "   Parallel task A";
        out "   Parallel task B";
        out "   Parallel task C";
    }
    out "";
    
    // Summary
    out "╔════════════════════════════════════════════════════════╗";
    out "║  Summary of Supported Features                        ║";
    out "╚════════════════════════════════════════════════════════╝";
    out "";
    out "V5.2 Parser Features:";
    out "  ✓ Use statements (imports)";
    out "  ✓ Type aliases";
    out "  ✓ Type tokens as identifiers in paths";
    out "";
    out "V5.0 Language Features (All Working):";
    out "  ✓ Explicit type annotations";
    out "  ✓ Arrays with indexing";
    out "  ✓ All arithmetic operators (+, -, *, /, %, **)";
    out "  ✓ All comparison operators (==, !=, <, >, <=, >=)";
    out "  ✓ All logical operators (and, or, not)";
    out "  ✓ Bitwise operators (&, |, ^, ~)";
    out "  ✓ Control flow (if/elif/else)";
    out "  ✓ While loops";
    out "  ✓ For loops";
    out "  ✓ Infinite loops with break/continue";
    out "  ✓ String operations";
    out "  ✓ Ownership qualifiers (own, mut)";
    out "  ✓ Memory operations (copy, move)";
    out "  ✓ Scoped blocks";
    out "  ✓ Procedure calls";
    out "  ✓ Parallel execution";
    out "";
    out "✨ LPPO V5.2 Parser Support Complete! ✨";
}

pub proc helper_function(value: Int64, name: Str) -> Void {
    out "   Helper called with:", value, name;
}
