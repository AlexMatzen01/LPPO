// LPPO v2.0 - Advanced Math Library Example
// Demonstrates module organization and mathematical operations

module math {
    // Absolute value
    pub proc abs(n: Int64) -> Void {
        let own zero: Int64 = 0;
        let own is_negative: Bool = n < zero;
        
        if is_negative {
            let own neg_one: Int64 = -1;
            let own result: Int64 = n * neg_one;
            let own label: Str = "abs:";
            out label, result;
        } else {
            let own label: Str = "abs:";
            out label, n;
        }
    }
    
    // Maximum of two numbers
    pub proc max(a: Int64, b: Int64) -> Void {
        let own is_greater: Bool = a > b;
        
        if is_greater {
            let own label: Str = "max:";
            out label, a;
        } else {
            let own label: Str = "max:";
            out label, b;
        }
    }
    
    // Minimum of two numbers
    pub proc min(a: Int64, b: Int64) -> Void {
        let own is_less: Bool = a < b;
        
        if is_less {
            let own label: Str = "min:";
            out label, a;
        } else {
            let own label: Str = "min:";
            out label, b;
        }
    }
    
    // Factorial (iterative)
    pub proc factorial(n: Int64) -> Void {
        let mut own result: Int64 = 1;
        let mut own i: Int64 = 1;
        let own one: Int64 = 1;
        
        while i <= n {
            let own temp: Int64 = result * i;
            move temp -> result;
            
            let own i_next: Int64 = i + one;
            move i_next -> i;
        }
        
        let own label: Str = "factorial:";
        out label, result;
    }
    
    // Power function (using explicit loop)
    pub proc power(num: Int64, exponent: Int64) -> Void {
        let mut own result: Int64 = 1;
        let mut own i: Int64 = 0;
        let own one: Int64 = 1;
        
        while i < exponent {
            let own temp: Int64 = result * num;
            move temp -> result;
            
            let own i_next: Int64 = i + one;
            move i_next -> i;
        }
        
        let own label: Str = "power:";
        out label, result;
    }
    
    // Sum of array elements
    pub proc sum_array(arr: Arr<Int64>) -> Void {
        let mut own sum: Int64 = 0;
        
        for num: Int64 in arr {
            let own temp: Int64 = sum + num;
            move temp -> sum;
        }
        
        let own label: Str = "sum:";
        out label, sum;
    }
    
    // Average of array elements
    pub proc average(arr: Arr<Int64>) -> Void {
        let mut own sum: Int64 = 0;
        
        for num: Int64 in arr {
            let own temp: Int64 = sum + num;
            move temp -> sum;
        }
        
        let own len: Int64 = arr.len();
        let own avg: Int64 = sum / len;
        
        let own label: Str = "average:";
        out label, avg;
    }
    
    // Find maximum in array
    pub proc array_max(arr: Arr<Int64>) -> Void {
        let own zero: Int64 = 0;
        let mut own max_val: Int64 = arr[zero];
        
        for num: Int64 in arr {
            let own is_greater: Bool = num > max_val;
            if is_greater {
                move num -> max_val;
            }
        }
        
        let own label: Str = "array max:";
        out label, max_val;
    }
}

module stats {
    // Range (max - min)
    pub proc find_range(arr: Arr<Int64>) -> Void {
        let own zero: Int64 = 0;
        let mut own min_val: Int64 = arr[zero];
        let mut own max_val: Int64 = arr[zero];
        
        for num: Int64 in arr {
            let own is_less: Bool = num < min_val;
            if is_less {
                move num -> min_val;
            }
            
            let own is_greater: Bool = num > max_val;
            if is_greater {
                move num -> max_val;
            }
        }
        
        let own range_val: Int64 = max_val - min_val;
        let own label: Str = "range:";
        out label, range_val;
    }
    
    // Count even numbers
    pub proc count_even(arr: Arr<Int64>) -> Void {
        let mut own count: Int64 = 0;
        let own zero: Int64 = 0;
        let own two: Int64 = 2;
        let own one: Int64 = 1;
        
        for num: Int64 in arr {
            let own rem: Int64 = num % two;
            let own is_even: Bool = rem == zero;
            
            if is_even {
                let own temp: Int64 = count + one;
                move temp -> count;
            }
        }
        
        let own label: Str = "even count:";
        out label, count;
    }
    
    // Count odd numbers
    pub proc count_odd(arr: Arr<Int64>) -> Void {
        let mut own count: Int64 = 0;
        let own zero: Int64 = 0;
        let own two: Int64 = 2;
        let own one: Int64 = 1;
        
        for num: Int64 in arr {
            let own rem: Int64 = num % two;
            let own is_odd: Bool = rem != zero;
            
            if is_odd {
                let own temp: Int64 = count + one;
                move temp -> count;
            }
        }
        
        let own label: Str = "odd count:";
        out label, count;
    }
}

pub proc main() -> Void {
    let own header: Str = "=== LPPO Math Library Demo ===";
    out header;
    
    // Test basic math operations
    let own section1: Str = "\n--- Basic Operations ---";
    out section1;
    
    let own neg_five: Int64 = -5;
    call math::abs(neg_five);
    
    let own a: Int64 = 42;
    let own b: Int64 = 17;
    call math::max(a, b);
    call math::min(a, b);
    
    // Test factorial and power
    let own section2: Str = "\n--- Factorial and Power ---";
    out section2;
    
    let own five: Int64 = 5;
    call math::factorial(five);
    
    let own two: Int64 = 2;
    let own eight: Int64 = 8;
    call math::power(two, eight);
    
    // Test array operations
    let own section3: Str = "\n--- Array Operations ---";
    out section3;
    
    let own numbers: Arr<Int64> = [10, 25, 15, 30, 20];
    out "Array:", numbers;
    
    call math::sum_array(numbers);
    call math::average(numbers);
    call math::array_max(numbers);
    
    // Test statistics
    let own section4: Str = "\n--- Statistics ---";
    out section4;
    
    let own data: Arr<Int64> = [5, 12, 8, 15, 3, 20, 7, 11];
    out "Data:", data;
    
    call stats::find_range(data);
    call stats::count_even(data);
    call stats::count_odd(data);
    
    // Demonstrate parallel execution
    let own section5: Str = "\n--- Parallel Execution ---";
    out section5;
    
    scope parallel_section {
        parallel {
            out "Computing statistics...";
            out "Processing data...";
            out "Analyzing results...";
        }
    }
    
    let own footer: Str = "\n=== Demo Complete ===";
    out footer;
}
