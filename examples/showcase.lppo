// LPPO Feature Showcase - Everything in one program!

proc main {
    out "╔═══════════════════════════════════╗";
    out "║   LPPO Language Feature Showcase  ║";
    out "╚═══════════════════════════════════╝";
    out "";
    
    // Variables and expressions
    let x = 42;
    let y = 8;
    call math_demo(x, y);
    
    // Arrays
    call array_demo();
    
    // Loops
    call loop_demo();
    
    // Strings
    call string_demo();
    
    // Parallel
    out "";
    out "► Parallel Execution:";
    parallel {
        out "  ⚡ Thread 1 executing...";
        out "  ⚡ Thread 2 executing...";
        out "  ⚡ Thread 3 executing...";
    }
    
    out "";
    out "✓ All features demonstrated successfully!";
}

proc math_demo(a, b) {
    out "";
    out "► Arithmetic & Operators:";
    out "  a =", a, ", b =", b;
    out "  a + b =", a + b;
    out "  a - b =", a - b;
    out "  a * b =", a * b;
    out "  a / b =", a / b;
    out "  a % b =", a % b;
    out "  a ** 2 =", a ** 2;
    
    // Comparisons
    if a > b {
        out "  a > b is true";
    }
    
    // Bitwise
    out "  a & b =", a & b;
    out "  a | b =", a | b;
    out "  a ^ b =", a ^ b;
    out "  ~b =", ~b;
}

proc array_demo {
    out "";
    out "► Arrays & Indexing:";
    let arr = [10, 20, 30, 40, 50];
    out "  Array:", arr;
    out "  Length:", arr.len();
    out "  First:", arr[0];
    out "  Last:", arr[-1];
    out "  Third:", arr[2];
    
    // Array operations
    let more = [60, 70];
    let combined = arr + more;
    out "  Combined:", combined;
    
    // Iterate
    out "  Iterating:";
    for val in [1, 2, 3] {
        out "    •", val;
    }
}

proc loop_demo {
    out "";
    out "► Loop Control:";
    
    // While with break
    out "  While with break:";
    let i = 0;
    while i < 10 {
        if i == 3 {
            out "    Breaking at", i;
            break;
        }
        out "    i =", i;
        let i = i + 1;
    }
    
    // For with continue
    out "  For with continue (odds only):";
    for n in [1, 2, 3, 4, 5, 6] {
        if n % 2 == 0 {
            continue;
        }
        out "    Odd:", n;
    }
    
    // Infinite loop
    out "  Loop with counter:";
    let count = 0;
    loop {
        out "    Count:", count;
        let count = count + 1;
        if count >= 2 {
            break;
        }
    }
}

proc string_demo {
    out "";
    out "► String Operations:";
    let msg = "Hello LPPO World";
    out "  Original:", msg;
    out "  Length:", msg.len();
    out "  Uppercase:", msg.upper();
    out "  Lowercase:", msg.lower();
    
    let csv = "apple,banana,cherry";
    let fruits = csv.split(",");
    out "  Split CSV:", fruits;
    
    // Concatenation
    let greeting = "Hello" + " " + "from" + " " + "LPPO!";
    out "  Concatenated:", greeting;
}
