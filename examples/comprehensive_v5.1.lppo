#[test]
pub proc test_addition() -> Void {
    let own result: Int64 = 2 + 2;
    assert_eq!(result, 4, "2 + 2 should equal 4");
}

#[test]
pub proc test_division() -> Void {
    let own result: Result<Int64, Str> = divide(10, 2);
    assert!(result.is_ok(), "Division should succeed");
    assert_eq!(result.unwrap(), 5, "10 / 2 should equal 5");
}

#[test]
pub proc test_division_by_zero() -> Void {
    let own result: Result<Int64, Str> = divide(10, 0);
    assert!(result.is_err(), "Division by zero should fail");
}

#[bench]
pub proc bench_vector_operations() -> Void {
    let own vec: Vec<Int64> = (0..1000).collect();
    benchmark(|| {
        vec.iter().map(|x| x * 2).sum()
    });
}

