pub proc main() -> Void {
    out "=== Greeting Program ===";

    input name: Str with "What is your name?";
    input hour: Int64 with "What hour is it (0-23)?";

    out "Hello,", name,"!";

    if hour < 12 {
        out "Good morning!";
    } elif hour < 18 {
        out "Good afternoon!";
    } else {
        out "Good evening!";
    }

    out "Have a great day,", name;
}
